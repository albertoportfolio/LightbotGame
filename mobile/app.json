{
  "expo": {
    "name": "Lightbot",
    "slug": "lightbot-mobile",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "lightbot",
    "splash": {
      "backgroundColor": "#1a1a2e",
      "image": "./assets/splash.png",
      "resizeMode": "contain"
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lightbot.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e",
        "foregroundImage": "./assets/icon.png"
      },
      
      "googleServicesFile": "./google-services.json",
      "package": "com.lightbot.app"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "52249e76-2788-42a3-96ea-c0a4ad3f18b5"
      }
    }
  }
}