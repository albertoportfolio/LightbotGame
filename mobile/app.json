{
  "expo": {
    "name": "Lightbot",
    "slug": "lightbot-mobile",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "lightbot",
    "splash": {
      "backgroundColor": "#1a1a2e"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lightbot.mobile"
    },
    "android": {
      "kotlinVersion": "1.9.25",
      "navigationBar": {
        "visible": "immersive"
      },
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.lightbot.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-asset"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "52249e76-2788-42a3-96ea-c0a4ad3f18b5"
      }
    }
  }
}
